# Normalize line endings to LF in the repository so Windows checkouts do not
# produce spurious diffs against files authored elsewhere.
* text=auto eol=lf

# Preserve binary artifacts exactly.
*.pyc binary
*.bin binary
*.pcap binary
*.sqlite binary

# ESP-IDF and CMake inputs.
*.c text
*.h text
*.py text
*.md text
*.txt text
*.toml text
Kconfig.projbuild text
CMakeLists.txt text
