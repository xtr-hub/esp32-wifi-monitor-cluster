# --- ESP-IDF build output ---
build/
build-*/
*.bin
*.elf
*.map
*.uf2

# --- ESP-IDF local configuration (holds Wi-Fi credentials and the OTA token) ---
sdkconfig
sdkconfig.old
sdkconfig.ci

# Local ESP-IDF installation-manager configuration (machine-specific paths).
eim_config.toml

# Managed components are re-fetched by the component manager from idf_component.yml.
managed_components/

# --- Captured traffic and derived data (multi-gigabyte, never commit) ---
captures/
telemetry.jsonl
*.pcap
*.pcap.offset
decoded-*.txt
*.sqlite
*.sqlite-wal
*.sqlite-shm

# --- Runtime state from background capture ---
.wimon/

# --- Logs ---
*.log
*.err.log
*.out.log

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
dist/
*.egg-info/

# --- Editors and OS ---
.vscode/
.idea/
.cache/
.commandcode/
Thumbs.db
desktop.ini
